      "faqs": {
        "variants": {
          "PetcareFaqs1": {
            "badge": {
              "icon": "bone",
              "text": "Popular Questions"
            },
            "headline": {
              "line1": "FAQs: Get the",
              "line2": "Answers You",
              "line3": "Need to Know"
            },
            "cta": {
              "label": "Get in Touch",
              "href": "/contact"
            },
            "items": [
              {
                "id": "faq-1",
                "question": "Which vaccinations does my pet need?",
                "answer": "Essential core vaccinations include Rabies, DHPP for dogs (Distemper, Hepatitis, Parvovirus, Parainfluenza), and FVRCP for cats. Additional non-core vaccines depend on your pet's age, outdoor exposure, and regional disease risks."
              },
              {
                "id": "faq-2",
                "question": "What should I bring to my pet's first appointment?",
                "answer": "Please bring your pet's prior medical and vaccination history, a list of current medications or supplements, adoption or breeder paperwork, and a favorite blanket or toy to keep them calm and comfortable."
              },
              {
                "id": "faq-3",
                "question": "Do you offer emergency veterinary services?",
                "answer": "Yes, we provide emergency triage and urgent care services during our regular clinical hours. For critical after-hours emergencies, we coordinate directly with accredited 24/7 emergency animal trauma centers."
              },
              {
                "id": "faq-4",
                "question": "How often should my pet have a dental checkup?",
                "answer": "We recommend an oral examination at least once a year during regular wellness visits. Pets showing early signs of tartar buildup or breath odor may benefit from cleanings every 6 to 12 months."
              },
              {
                "id": "faq-5",
                "question": "When should I spay or neuter my pet?",
                "answer": "Most puppies and kittens are typically spayed or neutered between 5 to 9 months of age. Larger dog breeds may benefit from waiting until full growth plate closure at 12 to 18 months."
              },
              {
                "id": "faq-6",
                "question": "Do you treat both dogs and cats?",
                "answer": "Absolutely! Our facility is equipped with dedicated dog-friendly and low-stress cat examination rooms to ensure comfortable, individualized care for both species."
              },
              {
                "id": "faq-7",
                "question": "What diagnostic services do you offer?",
                "answer": "Our diagnostic suite includes high-resolution digital X-rays, ultrasound imaging, in-house hematology and biochemical blood testing, urinalysis, and microscopic cytology for rapid results."
              },
              {
                "id": "faq-8",
                "question": "How can I schedule an appointment?",
                "answer": "You can easily book online via our appointment booking portal, give our reception desk a call, or send us a WhatsApp message to select your preferred date and veterinarian."
              },
              {
                "id": "faq-9",
                "question": "How do I know if my pet is overweight?",
                "answer": "You should easily be able to feel your pet's ribs without pressing hard, and observe a noticeable waistline tuck behind their ribs when viewed from above. Our vets can provide a Body Condition Score (BCS)."
              },
              {
                "id": "faq-10",
                "question": "Why is dental care important for pets?",
                "answer": "Untreated periodontal disease causes oral pain, tooth loss, and allows harmful oral bacteria to enter the bloodstream, potentially affecting your pet's heart, kidneys, and liver."
              }
            ]
          }
        }
      },
